# AHAM Backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_NAME=AHAM API
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aham

# Firebase Admin SDK (from Firebase Console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escape sequences from the private key on one line
FIREBASE_PRIVATE_KEY=

# CORS / Frontend
FRONTEND_URL=http://localhost:5173

# Email notifications (used in later phases)
ADMIN_EMAIL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
